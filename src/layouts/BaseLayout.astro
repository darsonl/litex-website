---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /**
   * Emit <meta name="robots" content="noindex">. For pages that must never be a search
   * result: the 404 page, and the enquiry confirmation, which would otherwise tell a
   * stranger arriving from a search result that LiTex has their enquiry. Everything else
   * on this site is meant to be found, so the default is false.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteNav />
    <main id="main" class="page">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
