---
import { NAV } from '../lib/nav';

const here = Astro.url.pathname;
// A section is current when you are on its index or anywhere beneath it, so a
// product detail page still shows Products as the active section.
const isCurrent = (href: string) => here === href || here.startsWith(href);
---
<header class="masthead" data-masthead>
  <div class="inner">
    <a class="wordmark" href="/">
      <span class="name">LiTex</span>
      <span class="sub">Textile &amp; Technology</span>
    </a>

    <!--
      A native disclosure, not a scripted one.

      Seven links wrapping to two rows cost 153px of an 844px phone viewport — 18% of the
      fold spent before the first word of content, with each link 20px tall. Below 40rem
      the list collapses behind this control; above it, CSS reopens the details and the
      row of links is exactly what it always was.

      <details> rather than a button and a script because this site ships JavaScript only
      for the two enquiry forms. Navigation is the last thing that should be able to fail
      to a blank state, and the disclosure has to keep working for a visitor whose network
      dropped the bundle. tests/responsive.test.ts opens it with JavaScript disabled.
    -->
    <details class="menu" data-navmenu>
      <summary>Menu</summary>
      <nav aria-label="Primary">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .masthead {
    position: relative; /* the containing block for the open menu panel */
    border-bottom: 1px solid var(--c-line);
    background: var(--c-base);
  }
  .inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--s-4) var(--s-6);
    display: flex;
    gap: var(--s-4) var(--s-8);
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    color: var(--c-text-1);
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }
  .name {
    font-size: var(--t-20);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: var(--t-10);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-text-2);
  }
  .wordmark:hover .name { color: var(--c-copper-lift); }

  /* ---- the control ---- */

  /* list-style:none removes the disclosure triangle in Firefox and modern Blink; the
     ::-webkit-details-marker rule covers Safari, which still uses the older pseudo. */
  .menu > summary {
    list-style: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--t-12);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-2);
    cursor: pointer;
  }
  .menu > summary::-webkit-details-marker { display: none; }
  .menu > summary:hover { color: var(--c-text-1); }

  /* Drawn from borders rather than set as a glyph. `content: ''` contributes nothing to
     the accessible name, so the control is announced as "Menu" and not "Menu ▾". */
  .menu > summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-left: var(--s-2);
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
    transition: transform 150ms ease;
  }
  .menu[open] > summary::after { transform: translateY(0.1rem) rotate(-135deg); }

  /* ---- the panel, phone only ---- */

  /* Absolutely positioned so opening the menu never changes the height of the masthead
     itself — the measurement the 96px guard in tests/responsive.test.ts protects. */
  .menu > nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 20;
    background: var(--c-base);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.45);
  }
  .menu > nav ul {
    list-style: none;
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--s-2) var(--s-6) var(--s-4);
  }
  /* min-height rather than padding: it states the target size outright instead of
     leaving it to be inferred from a line-height that could change under it. */
  .menu > nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--t-14);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-2);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: var(--s-3);
  }
  .menu > nav a:hover { color: var(--c-text-1); }
  /* The active section is marked by colour *and* a rule, never colour alone. On a
     vertical list that rule runs down the side rather than under the text. */
  .menu > nav a[aria-current='page'] {
    color: var(--c-copper);
    border-left-color: var(--c-copper);
  }

  /* ---- 40rem and up: no disclosure, the original row of links ---- */

  @media (min-width: 40rem) {
    .inner { align-items: baseline; }
    .menu > summary { display: none; }

    /* Two mechanisms for one outcome, kept as SEPARATE rules on purpose.
       Chromium 131+ hides the contents of a closed <details> with content-visibility on
       ::details-content; engines before that used display on the children. An engine
       that does not recognise the pseudo-element discards that rule and keeps this one —
       but only because they are not written as a single selector list, where one
       unsupported selector would invalidate both. Same lesson as the :has() note in the
       print block of global.css. */
    .menu::details-content { content-visibility: visible; }
    .menu > nav {
      display: block;
      position: static;
      background: none;
      border-bottom: 0;
      box-shadow: none;
    }

    .menu > nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-6);
      margin: 0;
      padding: 0;
    }
    .menu > nav a {
      display: inline;
      min-height: 0;
      font-size: var(--t-12);
      border-left: 0;
      padding-left: 0;
      padding-bottom: var(--s-1);
      border-bottom: 1px solid transparent;
    }
    .menu > nav a[aria-current='page'] { border-bottom-color: var(--c-copper); }
  }

  /* ---- 56.25rem and up: the row stays with the reader ---- */

  /* The breakpoint is measured, not chosen. The seven-link row wraps to two rows from
     40rem to 55rem — 111.59px, a seventh of an 800px window — and only fits on one line
     at 900px, where the masthead is 64.00px. So the masthead sticks only where sticking
     is cheap; below this it scrolls away exactly as it always has.

     Overriding position here is safe: the `relative` above exists to be the containing
     block for the phone menu panel, and at 40rem and up that panel is already `static`
     and its control `display: none`. Nothing above this breakpoint is absolutely
     positioned against the masthead.

     ⚠ position:sticky is defeated by an `overflow` value on ANY ancestor. There is none
     today on html, body or any wrapper — adding one would un-stick this silently, which
     is why tests/responsive.test.ts scrolls the page rather than reading the computed
     position. */
  @media (min-width: 56.25rem) {
    .masthead { position: sticky; top: 0; z-index: 10; }
  }

  /* The shadow is the only part of this that needs to know the page has scrolled, and a
     scroll-driven animation is how it finds out without shipping JavaScript.

     Guarded because support is not universal: Chrome/Edge 115+ and Safari 26+ have it,
     but Firefox stable still keeps it behind layout.css.scroll-driven-animations.enabled
     as of Firefox 152 (June 2026) — roughly 83% of visitors. Where it is absent the
     animation simply never runs and the masthead keeps the opaque background and 1px
     rule it already has, which separates it from content perfectly well. That degraded
     state is a good design, not a broken one.

     ⚠ Do not "fix" Firefox with a script. It would be the first JavaScript this site
     ships for chrome rather than for the enquiry forms, and it would buy a decoration.

     Two things below depart from the shorthand a first draft would reach for, and both
     are load-bearing rather than stylistic:

     1. Longhand animation-name/-timing-function/-fill-mode instead of the `animation`
        shorthand. This build's CSS minifier (lightningcss, via Vite) folds a longhand
        `animation-timeline: scroll()` back into the `animation` shorthand whenever one
        is present — but Chromium's parser does not yet accept `scroll()` inside that
        shorthand, so it discards the whole merged declaration and the masthead never
        animates at all. Longhand-only gives the minifier nothing to fold, so it survives
        the build unmerged. Verified in dist/_astro/*.css after each build.

     2. `animation-range: 1px 4rem` (not `0 4rem`) with `fill-mode: forwards` (not
        `both`). At scroll 0 with a range starting at 0, the animation is already inside
        its active phase, and Chromium reports the interpolated progress-0 box-shadow as
        an explicit transparent shadow (`rgba(0 0 0 / 0) 0 0 0 0`) rather than the
        keyword `none` — cosmetically identical but a different computed-style string,
        which is what tests/responsive.test.ts asserts on. Starting the range 1px later
        puts scroll 0 in the animation's *before* phase; `forwards` fill (unlike `both`)
        applies no effect there, so box-shadow falls through to its true un-animated
        value, `none`. The one-pixel shift is invisible and the fade still spans
        essentially the first 64px of scroll. */
  @supports (animation-timeline: scroll()) {
    @media (min-width: 56.25rem) {
      .masthead {
        animation-name: masthead-lift;
        animation-timing-function: linear;
        animation-fill-mode: forwards;
        animation-timeline: scroll();
        animation-range: 1px 4rem;
      }
    }
  }
  @keyframes masthead-lift {
    from { box-shadow: none; }
    to { box-shadow: 0 1px 12px rgb(0 0 0 / 0.45); }
  }
</style>
