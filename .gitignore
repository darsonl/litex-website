# NOTE: archive/ is deliberately NOT ignored.
# It is the complete captured copy of the original litextextile.wordpress.com site
# (23 pages, 6 PDF catalogs, 46 images — ~42 MB) and is the source material the new
# site is built from. Versioning it is intentional: it makes every spec figure
# traceable and survives the original site being changed or taken down.
# Do not add it here. See archive/README.md.

# Brainstorming companion session data (mockups kept locally, not versioned)
.superpowers/

# Node / Astro
node_modules/
dist/
.astro/
.output/
.vercel/
.wrangler/

# Catalog PDFs, copied out of archive/ by scripts/sync-catalogs.mjs at build time.
# The archive copy is the versioned one; see scripts/sync-catalogs.mjs.
public/catalogs/

# The Sveltia CMS bundle, copied out of node_modules by scripts/sync-cms.mjs at build
# time. package-lock.json is the versioned record of which version that is; a committed
# copy would drift from it silently.
public/admin/sveltia-cms.js

# Env
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Impeccable local state
.impeccable/config.local.json

# Critique snapshots are a local backlog, not a repo artifact. /impeccable polish
# reads them to pick up priority issues without a copy-paste; they record one
# machine's run at one moment and would otherwise churn on every critique.
.impeccable/critique/
